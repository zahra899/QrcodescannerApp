<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1115">

    <ImageView
        android:id="@+id/btnBackUrl"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:contentDescription="Back"
        android:src="@android:drawable/ic_menu_revert"
        app:tint="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="URL"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btnBackUrl"
        app:layout_constraintStart_toEndOf="@id/btnBackUrl"
        app:layout_constraintTop_toTopOf="@id/btnBackUrl"
        android:layout_marginStart="16dp" />

    <TextView
        android:id="@+id/tvUrlLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Website Link"
        android:textColor="#10FA9E"
        android:textSize="11sp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/btnBackUrl"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/etUrlInput"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/circle_dark_button"
        android:backgroundTint="#10FA9E"
        android:paddingHorizontal="16dp"
        android:hint="https://example.com"
        android:textColor="#000000"
        android:textColorHint="#33000000"
        android:inputType="textUri"
        android:autofillHints=""
        app:layout_constraintTop_toBottomOf="@id/tvUrlLabel" />

    <Button
        android:id="@+id/btnGenerateUrl"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="#10FA9E"
        android:text="Generate QR Code"
        android:textAllCaps="false"
        android:textColor="#000000"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/etUrlInput" />

</androidx.constraintlayout.widget.ConstraintLayout>