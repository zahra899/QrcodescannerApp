<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1115">

    <ImageView
        android:id="@+id/btnBackText"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:contentDescription="Back"
        android:src="@android:drawable/ic_menu_revert"
        app:tint="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Text"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btnBackText"
        app:layout_constraintStart_toEndOf="@id/btnBackText"
        app:layout_constraintTop_toTopOf="@id/btnBackText"
        android:layout_marginStart="16dp" />

    <TextView
        android:id="@+id/tvTextLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your Text"
        android:textColor="#10FA9E"
        android:textSize="11sp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/btnBackText"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/etTextInput"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="56dp"
        android:background="@drawable/circle_dark_button"
        android:backgroundTint="#1A1D21"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:gravity="top"
        android:hint="Type any text here..."
        android:textColor="#FFFFFF"
        android:textColorHint="#8E8E93"
        android:inputType="textMultiLine"
        android:autofillHints=""
        app:layout_constraintTop_toBottomOf="@id/btnBackText" />

    <Button
        android:id="@+id/btnGenerateText"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="#10FA9E"
        android:text="Generate QR Code"
        android:textAllCaps="false"
        android:textColor="#000000"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/etTextInput" />

</androidx.constraintlayout.widget.ConstraintLayout>