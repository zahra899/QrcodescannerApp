<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1115">

    <TextView
        android:id="@+id/tvHistoryTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:text="History"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/layoutSelectionControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/tvHistoryTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvHistoryTitle">

        <ImageView
            android:id="@+id/btnSelectAll"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="16dp"
            android:contentDescription="Select All"
            android:src="@android:drawable/checkbox_off_background"
            app:tint="#8E8E93" />

        <ImageView
            android:id="@+id/btnDeleteSelected"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="Delete Selected"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="#10FA9E" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/filterScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/tvHistoryTitle">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/filterAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:background="@drawable/circle_dark_button"
                android:paddingHorizontal="18dp"
                android:paddingVertical="8dp"
                android:text="All"
                android:textColor="#10FA9E"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/filterUrls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:background="@drawable/circle_dark_button"
                android:paddingHorizontal="18dp"
                android:paddingVertical="8dp"
                android:text="URLs"
                android:textColor="#8E8E93"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/filterWifi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:background="@drawable/circle_dark_button"
                android:paddingHorizontal="18dp"
                android:paddingVertical="8dp"
                android:text="WiFi"
                android:textColor="#8E8E93"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/filterContacts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:background="@drawable/circle_dark_button"
                android:paddingHorizontal="18dp"
                android:paddingVertical="8dp"
                android:text="Contacts"
                android:textColor="#8E8E93"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/filterFavorites"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/circle_dark_button"
                android:paddingHorizontal="18dp"
                android:paddingVertical="8dp"
                android:text="Favorites"
                android:textColor="#8E8E93"
                android:textSize="13sp" />

        </LinearLayout>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHistory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomAppTabsSystem"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/filterScrollView" />

    <LinearLayout
        android:id="@+id/emptyStateLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        app:layout_constraintBottom_toTopOf="@id/bottomAppTabsSystem"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/filterScrollView">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:contentDescription="Empty QR Icon"
            android:src="@android:drawable/ic_menu_camera"
            app:tint="#10FA9E" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="NO Scans Yet"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Your scanned QR codes and barcodes will appear here"
            android:textColor="#8E8E93"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnStartScanning"
            android:layout_width="240dp"
            android:layout_height="54dp"
            android:layout_marginTop="32dp"
            android:backgroundTint="#00E676"
            android:text="Start Scanning"
            android:textAllCaps="false"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomAppTabsSystem"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="#161616"
        app:itemIconTint="#8E8E93"
        app:itemTextColor="#8E8E93"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/bottom_nav_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>