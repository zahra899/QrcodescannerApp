<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1115">

    <ImageView
        android:id="@+id/btnBackCalendar"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:contentDescription="Back"
        android:src="@android:drawable/ic_menu_revert"
        app:tint="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Calendar Event"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btnBackCalendar"
        app:layout_constraintStart_toEndOf="@id/btnBackCalendar"
        app:layout_constraintTop_toTopOf="@id/btnBackCalendar"
        android:layout_marginStart="16dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/btnBackCalendar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Event Title"
                android:textColor="#10FA9E"
                android:textSize="11sp"
                android:layout_marginBottom="6dp" />
            <EditText
                android:id="@+id/etEventTitle"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/circle_dark_button"
                android:backgroundTint="#10FA9E"
                android:paddingHorizontal="16dp"
                android:hint="Birthday Party"
                android:textColor="#000000"
                android:textColorHint="#33000000"
                android:inputType="text"
                android:autofillHints=""
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Location (Optional)"
                android:textColor="#10FA9E"
                android:textSize="11sp"
                android:layout_marginBottom="6dp" />
            <EditText
                android:id="@+id/etEventLocation"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/circle_dark_button"
                android:backgroundTint="#10FA9E"
                android:paddingHorizontal="16dp"
                android:hint="Event location"
                android:textColor="#000000"
                android:textColorHint="#33000000"
                android:inputType="text"
                android:autofillHints=""
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start Date &amp; Time"
                android:textColor="#10FA9E"
                android:textSize="11sp"
                android:layout_marginBottom="6dp" />
            <EditText
                android:id="@+id/etEventStart"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/circle_dark_button"
                android:backgroundTint="#10FA9E"
                android:paddingHorizontal="16dp"
                android:hint="Tap to pick date"
                android:textColor="#000000"
                android:textColorHint="#33000000"
                android:focusable="false"
                android:clickable="true"
                android:autofillHints=""
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="End Date &amp; Time"
                android:textColor="#10FA9E"
                android:textSize="11sp"
                android:layout_marginBottom="6dp" />
            <EditText
                android:id="@+id/etEventEnd"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/circle_dark_button"
                android:backgroundTint="#10FA9E"
                android:paddingHorizontal="16dp"
                android:hint="Tap to pick date"
                android:textColor="#000000"
                android:textColorHint="#33000000"
                android:focusable="false"
                android:clickable="true"
                android:autofillHints=""
                android:layout_marginBottom="24dp" />

            <Button
                android:id="@+id/btnGenerateCalendar"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:backgroundTint="#10FA9E"
                android:text="Generate QR Code"
                android:textAllCaps="false"
                android:textColor="#000000"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>