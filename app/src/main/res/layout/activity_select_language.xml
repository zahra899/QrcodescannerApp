<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D0D0D"
    android:padding="20dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Languages"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_centerVertical="true" />

        <ImageView
            android:id="@+id/btnConfirm"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_check"
            app:tint="#FFFFFF" />
    </RelativeLayout>

    <RadioGroup
        android:id="@+id/radioGroupLanguages"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/rbEnglish"
            style="@style/LanguageRadioStyle"
            android:text="English"
            android:tag="en" />

        <RadioButton
            android:id="@+id/rbArabic"
            style="@style/LanguageRadioStyle"
            android:text="عربي"
            android:tag="ar" />

        <RadioButton
            android:id="@+id/rbHindi"
            style="@style/LanguageRadioStyle"
            android:text="Hindi"
            android:tag="hi" />

        <RadioButton
            android:id="@+id/rbBengali"
            style="@style/LanguageRadioStyle"
            android:text="Bengali"
            android:tag="bn" />

        <RadioButton
            android:id="@+id/rbJapanese"
            style="@style/LanguageRadioStyle"
            android:text="Japanese"
            android:tag="ja" />

        <RadioButton
            android:id="@+id/rbChinese"
            style="@style/LanguageRadioStyle"
            android:text="Chinese"
            android:tag="zh" />

    </RadioGroup>

</LinearLayout>