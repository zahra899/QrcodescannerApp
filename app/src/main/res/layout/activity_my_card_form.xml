<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1115">

    <ImageView
        android:id="@+id/btnBackMyCard"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="22dp"
        android:contentDescription="Back"
        android:src="@android:drawable/ic_menu_revert"
        app:tint="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvMyCardTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="My Card"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnBackMyCard"
        app:layout_constraintBottom_toBottomOf="@id/btnBackMyCard" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/btnBackMyCard"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- NAME -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Name"
                android:textColor="#10FA9E"
                android:textSize="11sp"
                android:layout_marginBottom="6dp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_field_green"
                android:layout_marginBottom="14dp">

                <ImageView
                    android:id="@+id/ivIconName"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_icon_avatar"
                    android:padding="5dp"
                    android:src="@android:drawable/ic_menu_myplaces"
                    app:tint="#000000" />

                <ImageView
                    android:id="@+id/btnClearName"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="14dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="#10FA9E" />

                <EditText
                    android:id="@+id/etCardName"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/ivIconName"
                    android:layout_toStartOf="@id/btnClearName"
                    android:layout_marginStart="10dp"
                    android:background="@null"
                    android:hint="Full name"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#5E6B66"
                    android:inputType="textPersonName"
                    android:autofillHints="name" />
            </RelativeLayout>

            <!-- PHONE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phone Number"
                android:textColor="#10FA9E"
                android:textSize="11sp"
                android:layout_marginBottom="6dp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_field_green"
                android:layout_marginBottom="14dp">

                <ImageView
                    android:id="@+id/ivIconPhone"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_icon_avatar"
                    android:padding="6dp"
                    android:src="@android:drawable/ic_menu_call"
                    app:tint="#000000" />

                <ImageView
                    android:id="@+id/btnPickContact"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="14dp"
                    android:src="@android:drawable/ic_menu_myplaces"
                    app:tint="#10FA9E" />

                <EditText
                    android:id="@+id/etCardPhone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/ivIconPhone"
                    android:layout_toStartOf="@id/btnPickContact"
                    android:layout_marginStart="10dp"
                    android:background="@null"
                    android:hint="+92 3XX XXXXXXX"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#5E6B66"
                    android:inputType="phone"
                    android:autofillHints="phone" />
            </RelativeLayout>

            <!-- EMAIL -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email Address"
                android:textColor="#10FA9E"
                android:textSize="11sp"
                android:layout_marginBottom="6dp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_field_green"
                android:layout_marginBottom="14dp">

                <ImageView
                    android:id="@+id/ivIconEmail"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_icon_avatar"
                    android:padding="6dp"
                    android:src="@android:drawable/ic_dialog_email"
                    app:tint="#000000" />

                <ImageView
                    android:id="@+id/btnClearEmail"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="14dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="#10FA9E" />

                <EditText
                    android:id="@+id/etCardEmail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/ivIconEmail"
                    android:layout_toStartOf="@id/btnClearEmail"
                    android:layout_marginStart="10dp"
                    android:background="@null"
                    android:hint="you@email.com"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#5E6B66"
                    android:inputType="textEmailAddress"
                    android:autofillHints="emailAddress" />
            </RelativeLayout>

            <!-- ADDRESS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Address"
                android:textColor="#10FA9E"
                android:textSize="11sp"
                android:layout_marginBottom="6dp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_field_green"
                android:layout_marginBottom="14dp">

                <ImageView
                    android:id="@+id/ivIconAddress"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_icon_avatar"
                    android:padding="6dp"
                    android:src="@android:drawable/ic_menu_mylocation"
                    app:tint="#000000" />

                <ImageView
                    android:id="@+id/btnClearAddress"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="14dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="#10FA9E" />

                <EditText
                    android:id="@+id/etCardAddress"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/ivIconAddress"
                    android:layout_toStartOf="@id/btnClearAddress"
                    android:layout_marginStart="10dp"
                    android:background="@null"
                    android:hint="Street, city"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#5E6B66"
                    android:inputType="textPostalAddress"
                    android:autofillHints="postalAddress" />
            </RelativeLayout>

            <!-- BIRTHDAY -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Birthday"
                android:textColor="#10FA9E"
                android:textSize="11sp"
                android:layout_marginBottom="6dp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_field_green"
                android:layout_marginBottom="14dp">

                <ImageView
                    android:id="@+id/ivIconBirthday"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_icon_avatar"
                    android:padding="6dp"
                    android:src="@android:drawable/ic_menu_month"
                    app:tint="#000000" />

                <ImageView
                    android:id="@+id/btnClearBirthday"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="14dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="#10FA9E" />

                <EditText
                    android:id="@+id/etCardBirthday"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/ivIconBirthday"
                    android:layout_toStartOf="@id/btnClearBirthday"
                    android:layout_marginStart="10dp"
                    android:background="@null"
                    android:hint="Tap to pick date"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#5E6B66"
                    android:focusable="false"
                    android:clickable="true"
                    android:autofillHints="" />
            </RelativeLayout>

            <!-- ORGANIZATION -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Organization"
                android:textColor="#10FA9E"
                android:textSize="11sp"
                android:layout_marginBottom="6dp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_field_green"
                android:layout_marginBottom="14dp">

                <ImageView
                    android:id="@+id/ivIconOrg"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_icon_avatar"
                    android:padding="6dp"
                    android:src="@android:drawable/ic_menu_manage"
                    app:tint="#000000" />

                <ImageView
                    android:id="@+id/btnClearOrg"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="14dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="#10FA9E" />

                <EditText
                    android:id="@+id/etCardOrg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/ivIconOrg"
                    android:layout_toStartOf="@id/btnClearOrg"
                    android:layout_marginStart="10dp"
                    android:background="@null"
                    android:hint="Company name"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#5E6B66"
                    android:inputType="text"
                    android:autofillHints="" />
            </RelativeLayout>

            <!-- NOTE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter Note"
                android:textColor="#10FA9E"
                android:textSize="11sp"
                android:layout_marginBottom="6dp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:background="@drawable/bg_field_green"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:id="@+id/btnClearNote"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentTop="true"
                    android:layout_margin="12dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="#10FA9E" />

                <EditText
                    android:id="@+id/etCardNote"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:padding="14dp"
                    android:gravity="top"
                    android:hint="Write a note..."
                    android:textColor="#FFFFFF"
                    android:textColorHint="#5E6B66"
                    android:inputType="textMultiLine"
                    android:autofillHints="" />
            </RelativeLayout>

            <Button
                android:id="@+id/btnGenerateMyCard"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:backgroundTint="#10FA9E"
                android:text="Generate QR Code"
                android:textAllCaps="false"
                android:textColor="#000000"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>